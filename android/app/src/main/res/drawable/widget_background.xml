<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #32's widget card background. Colors are static hex baked in at build time (RemoteViews
     can't consume the app's runtime oklch() theme tokens) — computed via scripts/oklch.mjs's
     tokenToHex() from theme/tokens.js's dark-theme sheetBg/accent (the app's default theme+icon
     style, per CLAUDE.md decision #8), not eyeballed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0F141D" />
    <stroke android:width="1dp" android:color="#4DACF6" />
    <corners android:radius="20dp" />
</shape>
